# ----------------------------------------------------------------------
# 1. 필수 제외 항목 (시스템 및 언어)
# ----------------------------------------------------------------------
# Python 컴파일 및 캐시 파일 (업로드 불필요)
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter Notebook 임시 저장소
.ipynb_checkpoints/

# OS 시스템 파일
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# 2. ROS2 빌드 아티팩트 (표준 제외 항목)
# ----------------------------------------------------------------------
# 빌드 결과물은 로컬 환경마다 다르므로 제외하고 src만 올리는 것이 표준임
build/
install/
log/

# ----------------------------------------------------------------------
# 3. IDE 및 설정 파일 (민감 정보 포함 가능성)
# ----------------------------------------------------------------------
# VSCode 설정 (경로 설정 등이 로컬 절대경로일 수 있어 제외 추천)
.vscode/
*.code-workspace

# PyCharm 등 기타 IDE
.idea/

# colcon 환경 설정 파일 (로컬 경로 포함 가능성 높음)
colcon.env

# ----------------------------------------------------------------------
# 4. 민감 정보 및 API 관련 (비용 발생 방지)
# ----------------------------------------------------------------------
# 환경변수 파일 (보통 여기에 API 키 저장함)
.env
*.env

# 일반적인 키 파일 패턴
*key.pem
secrets.yaml
credentials.json
token.txt
api_key.txt

# 데이터베이스 (로그 데이터에 개인정보 등이 있다면 제외 고려, 포폴용이면 포함 가능)
# *.db
# *.sqlite3

# ----------------------------------------------------------------------
# 5. 허용 항목 (사용자 요청 - 대용량 파일 유지)
# ----------------------------------------------------------------------
# 모델 파일, 데이터셋, 미디어 파일은 깃허브 용량 한계(100MB) 전까지는 허용
# 100MB 넘는 파일은 Git LFS 사용 필요 (여기서는 제외하지 않음)
# !*.pt
# !*.mp3
# !*.pgm
# !*.jpg
# !*.png